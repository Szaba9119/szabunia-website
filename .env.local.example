# Resend API key (https://resend.com) — WYMAGANE dla formularzy /api/contact i /api/lead
RESEND_API_KEY=

# Opcjonalne — powiadomienia z formularzy
# CONTACT_TO_EMAIL=marcin.szabunia@gmail.com
# CONTACT_FROM_EMAIL="Marcin Szabunia <onboarding@resend.dev>"

# CRM (Google Sheets) — opcjonalne; bez tych zmiennych zapis do CRM jest pomijany.
# URL webhooka Apps Script (kończy się na /exec) + sekret z webhook.gs — patrz Documents/CRM_2026/INSTRUKCJA_WDROZENIA.md
# CRM_WEBHOOK_URL=
# CRM_WEBHOOK_SECRET=

# Analytics (Plausible/Umami) — opcjonalne, podaj URL skryptu np. https://plausible.io/js/script.js
# NEXT_PUBLIC_ANALYTICS_URL=

# Ochrona formularzy /api/contact i /api/lead przed spamem/botami — WYMAGANE.
# Upstash Redis (rate-limit per IP) — https://upstash.com, Create Database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (CAPTCHA) — https://dash.cloudflare.com → Turnstile → Add Site
# Site Key jest publiczny (trafia do przeglądarki), Secret Key zostaje tylko na serwerze.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
